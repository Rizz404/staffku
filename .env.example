# Copy to .env.local (dev) or .env.production (server). Never commit the real file.

# OpenAI-compatible endpoint (LM Studio). Must end with /v1.
LLM_BASE_URL=https://local.fts-tech.co.id/v1
# Model id as listed by GET {LLM_BASE_URL}/models. Leave empty to auto-detect the first model.
LLM_MODEL=
# LM Studio API token. Chat answers "llm_not_configured" until this is set.
LLM_API_KEY=

# Optional tuning
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.6
# For reasoning models (Qwen3 etc.): "none" skips hidden thinking, so answers are fast and not cut off. Leave empty for normal models.
LLM_REASONING_EFFORT=
# Requests allowed per IP per 10 minutes, and max chats running at the same time.
RATE_LIMIT_PER_10MIN=12
MAX_CONCURRENT=3
